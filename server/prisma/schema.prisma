// 寻心理测评平台 - 统一表结构
// 设计理念：所有测评共享一张 assessments 表（题目/维度/报告模板存 JSON），
// 所有答卷与个性化报告共享一张 responses 表（答案/得分/报告存 JSON）。
// 新增测评无需建新表，插入一条记录即可；查询答卷按 assessmentId 过滤。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// 管理员 / 问卷生成者
model User {
  id           Int      @id @default(autoincrement())
  username     String   // 内部兼容字段，不再作为登录账号
  password     String   // md5 加密后的密码
  displayName  String
  nickname     String?  // 昵称（注册必填，应用层校验唯一性）
  avatar       String?  // 头像 URL（从系统预置 8 个头像中选择）
  email        String?  // 邮箱（注册补充，应用层校验唯一性）
  phone        String?  // 电话（注册补充，应用层校验唯一性）
  gender       String?  // 性别（注册补充）
  birthday     String?  // 生日（注册补充）
  wechatOpenId  String?  @unique
  wechatUnionId String?  // 微信开放平台 unionid：公众号授权与网站扫码登录共用的唯一标识
  status        String   @default("active") // 用户状态：active 正常 / blocked 禁用 / deleted 删除
  role          String   @default("admin")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  responses     Response[]

  @@index([wechatUnionId])
}

// 后台管理员：与 C 端 User 表完全分离
// - 不支持注册、不支持邮箱/手机号登录，只能用「管理员账号 + 密码」登录
// - role=super 为超级管理员，账号密码由服务端环境变量 ADMIN_USERNAME / ADMIN_PASSWORD 配置，
//   每次登录以环境变量为准并自动同步到本表（保证改密码立即生效、且操作日志可追溯）
// - 后续需要多个管理员时，由超级管理员在本表新增账号即可
model Admin {
  id          Int      @id @default(autoincrement())
  username    String   @unique
  password    String   // md5 加密后的密码
  displayName String
  role        String   @default("admin") // super=超级管理员 / admin=普通管理员
  status      String   @default("active") // active 正常 / disabled 停用
  lastLoginAt DateTime?
  lastLoginIp String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  logs        AdminLog[]

  @@index([status])
}

// 管理员操作日志：记录后台所有关键操作，便于审计追溯
model AdminLog {
  id        Int      @id @default(autoincrement())
  adminId   Int?
  admin     Admin?   @relation(fields: [adminId], references: [id], onDelete: SetNull)
  username  String   // 冗余保存，管理员被删除后仍可追溯
  action    String   // login / create / update / delete / restore / export / revoke / ...
  module    String   // auth / assessment / response / user / unlock_code / order / admin
  targetId  String?
  detail    String?  @db.Text
  ip        String?
  userAgent String?  @db.Text
  createdAt DateTime @default(now())

  @@index([adminId, createdAt])
  @@index([createdAt])
  @@index([module])
}

// 统一测评表：一个测评一行，题目/维度/报告模板均为 JSON
model Assessment {
  id              Int      @id @default(autoincrement())
  code            String   @unique
  name            String
  nameEn          String?
  category        String
  description     String   @db.Text
  instructions    String?  @db.Text
  coverColor      String   @default("#6366F1")
  icon            String?
  questions       String   @db.Text
  dimensions      String   @db.Text
  reportTemplates String   @db.Text
  status          String   @default("published")
  sortOrder       Int      @default(0)
  enablePairMatch Boolean  @default(false) // 是否开启双人匹配邀请（第一阶段 false，第二阶段 true）
  fillCount       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  responses       Response[]
}

// 统一答卷表：一次作答一行，答案/得分/个性化报告均为 JSON
model Response {
  id             Int        @id @default(autoincrement())
  assessmentId   Int
  userId         Int?
  assessment     Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  user           User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  answers        String   @db.Text
  score          String   @db.Text
  resultType     String
  totalScore     Float?
  report         String   @db.Text
  respondentName   String?
  wechatInfo       String?  @db.Text
  respondentInfo   String?  @db.Text
  duration         Int?
  ipAddress       String?
  userAgent       String?
  // 爱情测评（love）扩展
  mode           String?    // free=免费版 / deep=深度版 / partner=伴侣版
  pairCode       String?    // 双人匹配邀请码
  isPaid         Boolean    @default(false) // 是否已解锁深度报告
  paidAt         DateTime?
  // 爱情三角（lovetri）分享与双人配对扩展
  shareCode         String?    // 分享码（海报/链接分享用）
  sharedAt          DateTime?  // 首次分享时间
  partnerResponseId Int?       // 已配对的伴侣答卷 ID
  partnerName       String?    // 伴侣称呼（配对成功后回填）
  matchedAt         DateTime?  // 配对完成时间
  status          String     @default("active") // active | user_deleted | admin_deleted
  createdAt       DateTime @default(now())

  @@index([assessmentId, createdAt])
  @@index([userId])
  @@index([pairCode])
  @@index([shareCode])
  @@index([status])
}

// 订单表：付费解锁深度版
model Order {
  id          Int       @id @default(autoincrement())
  orderNo     String    @unique
  responseId  Int?
  amount      Float
  status      String    @default("pending") // pending=待支付 / paid=已支付 / closed=已关闭
  channel     String    @default("wechat")  // wechat=微信支付 / unlock=兑换码
  createdAt   DateTime  @default(now())
  paidAt      DateTime?

  @@index([responseId])
}

// 兑换码表：深度版解锁（支付上线前的过渡方案）
model UnlockCode {
  id          Int       @id @default(autoincrement())
  code        String    @unique
  amount      Float     @default(9.9)
  status      String    @default("unused") // unused=未使用 / used=已使用 / revoked=已作废
  responseId  Int?
  createdAt   DateTime  @default(now())
  usedAt      DateTime?

  @@index([responseId])
}
