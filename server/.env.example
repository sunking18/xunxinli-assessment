# 数据库连接（本地开发）
DATABASE_URL="mysql://root:root@localhost:3306/xunxinli"

# 生产环境（Docker Compose 内）使用：
# DATABASE_URL="mysql://xunxinli:xunxinli123@mysql:3306/xunxinli"

# JWT 密钥
JWT_SECRET="xunxinli-assessment-secret-change-me"
JWT_EXPIRES_IN="7d"

# 服务端口
PORT=3001

# 前端地址（用于跨域与二维码链接）
CLIENT_URL="http://localhost:5173"
PUBLIC_BASE_URL="http://localhost:5173"

# 微信开放平台 / 公众号配置（线上扫码登录用，本地测试留空跳过）
WECHAT_APP_ID=""
WECHAT_APP_SECRET=""
# 本地调试设为 true 时，答题免微信授权
DEV_SKIP_WECHAT="true"

# 管理员初始账号（seed 脚本创建）
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="admin123"
ADMIN_DISPLAY_NAME="平台管理员"
