# ===== 寻心理测评平台环境变量（docker compose 使用） =====

# MySQL（compose 自带独立容器，数据库名 xunxinli）
MYSQL_ROOT_PASSWORD=xunxinli_root_2026
MYSQL_PASSWORD=xunxinli123

# JWT 密钥（生产环境务必修改，建议: openssl rand -hex 32）
JWT_SECRET=xunxinli-assessment-secret-change-me

# 公网访问地址（二维码与微信回调使用）
CLIENT_URL=https://q.xunxinli.com
PUBLIC_BASE_URL=https://q.xunxinli.com

# 微信（本地留空即可）
WECHAT_APP_ID=
WECHAT_APP_SECRET=
DEV_SKIP_WECHAT=true

# 管理员初始账号
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

